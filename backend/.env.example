# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hungrybirds
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Browser origins allowed to call the API (comma separated)
CLIENT_ORIGINS=http://localhost:3000,http://localhost:3001

# Razorpay (test keys from https://dashboard.razorpay.com) — optional; COD works without them
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → secret (events: payment.captured, payment.failed, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary — optional; enables image uploads in the admin panel
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Phone OTP login: off | demo (code shown on screen, no SMS — good for portfolio demos) | twilio (real SMS)
# Default: demo in development, off in production.
OTP_PROVIDER=demo
# Only for OTP_PROVIDER=twilio — create a Verify Service at https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Pricing
GST_PERCENT=5
MAX_DELIVERY_KM=15

# Seed passwords (admin password is random if left empty)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=Demo@12345
SEED_RIDER_PASSWORD=Rider@12345
